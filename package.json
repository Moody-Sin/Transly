{
  "name": "transly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:bindings": "cargo run -p src-tauri --bin export_bindings",
    "build": "tsc && vite build",
    "preview": "vite preview",
