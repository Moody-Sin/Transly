{
  "name": "transly",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "lefthook install",
    "generate:bindings": "cargo run -p src-tauri --bin export_bindings",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"extension/src/**/*.ts\" \"extension/_locales/**/*.json\" extension/popup.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"extension/src/**/*.ts\" \"extension/_locales/**/*.json\" extension/popup.html",
    "test:task": "node --experimental-strip-types --test \"src/task/*.test.ts\" \"extension/src/shared/*.test.ts\"",
    "build:extension": "pnpm --filter transly-extension run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.17",
    "postcss": "^8.5.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.1.0"
  }
}
